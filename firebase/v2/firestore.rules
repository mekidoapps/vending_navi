rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public product/manufacturer master data.
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /manufacturers/{manufacturerId} {
      allow read: if true;
      allow write: if false;
    }

    // Public vending-machine root information.
    // During the v1/v2 coexistence period the same collection contains both
    // legacy and schemaVersion=2 documents, so reads are allowed at the
    // collection boundary. All client writes remain closed.
    match /vending_machines/{machineId} {
      allow read: if true;
      allow write: if false;

      match /products/{productId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Derived public search index.
    // Only Functions/Admin SDK may create or update entries.
    match /machine_product_index/{indexId} {
      allow read: if true;
      allow write: if false;
    }

    // Private user profile.
    //
    // Public/community writes continue to use Callable Functions.
    // This rule is intentionally limited to the authenticated user's own
    // profile document and to the two display-name compatibility fields.
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function hasValidOptionalDisplayNames() {
        return (
            !request.resource.data.keys().hasAny(['appDisplayName'])
            || (
              request.resource.data.appDisplayName is string
              && request.resource.data.appDisplayName.size() > 0
              && request.resource.data.appDisplayName.size() <= 30
            )
          )
          && (
            !request.resource.data.keys().hasAny(['displayName'])
            || (
              request.resource.data.displayName is string
              && request.resource.data.displayName.size() > 0
              && request.resource.data.displayName.size() <= 30
            )
          );
      }

      allow read: if isOwner();

      allow create: if isOwner()
        && request.resource.data.keys().hasOnly([
          'appDisplayName',
          'displayName',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && hasValidOptionalDisplayNames();

      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'appDisplayName',
          'displayName',
          'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && hasValidOptionalDisplayNames();

      allow delete: if false;
    }

    // photos, revisions and all other paths remain deny-by-default until
    // their own implementation phases.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public master data used by search and registration.
    // Reads are intentionally available without authentication.
    // All public writes remain denied from clients.
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /manufacturers/{manufacturerId} {
      allow read: if true;
      allow write: if false;
    }

    // Phase 2 keeps every other v2 path deny-by-default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

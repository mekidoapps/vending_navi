rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public product/manufacturer master data.
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /manufacturers/{manufacturerId} {
      allow read: if true;
      allow write: if false;
    }

    // Public vending-machine information.
    //
    // Legacy documents receive status=active through a non-destructive
    // compatibility backfill before these production Rules are deployed.
    // Non-public v2 states must never be exposed directly to clients.
    match /vending_machines/{machineId} {
      allow read: if resource.data.status == 'active';
      allow write: if false;

      match /products/{productId} {
        allow read: if resource.data.isActive == true
                    && get(
                      /databases/$(database)/documents/vending_machines/$(machineId)
                    ).data.status == 'active';
        allow write: if false;
      }
    }

    // Derived public search index.
    // Only publicly searchable entries may be read by clients.
    // Functions/Admin SDK remain the only writers.
    match /machine_product_index/{indexId} {
      allow read: if resource.data.isActive == true
                  && resource.data.machineStatus == 'active';
      allow write: if false;
    }

    // Private user profile.
    //
    // Public/community writes continue to use Callable Functions.
    // This rule is intentionally limited to the authenticated user's own
    // profile document and to the two display-name compatibility fields.
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function hasValidOptionalDisplayNames() {
        return (
            !request.resource.data.keys().hasAny(['appDisplayName'])
            || (
              request.resource.data.appDisplayName is string
              && request.resource.data.appDisplayName.size() > 0
              && request.resource.data.appDisplayName.size() <= 30
            )
          )
          && (
            !request.resource.data.keys().hasAny(['displayName'])
            || (
              request.resource.data.displayName is string
              && request.resource.data.displayName.size() > 0
              && request.resource.data.displayName.size() <= 30
            )
          );
      }

      allow read: if isOwner();

      allow create: if isOwner()
        && request.resource.data.keys().hasOnly([
          'appDisplayName',
          'displayName',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && hasValidOptionalDisplayNames();

      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'appDisplayName',
          'displayName',
          'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && hasValidOptionalDisplayNames();

      allow delete: if false;

      match /favorite_products/{productId} {
        allow read: if isOwner();

        allow create: if isOwner()
          && request.resource.data.keys().hasOnly([
            'productId',
            'sortOrder',
            'createdAt'
          ])
          && request.resource.data.productId == productId
          && request.resource.data.productId is string
          && request.resource.data.productId.size() > 0
          && request.resource.data.sortOrder is int
          && request.resource.data.sortOrder >= 0
          && request.resource.data.createdAt == request.time;

        allow update: if isOwner()
          && request.resource.data.keys().hasOnly([
            'productId',
            'sortOrder',
            'createdAt'
          ])
          && request.resource.data.productId == productId
          && request.resource.data.productId == resource.data.productId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.sortOrder is int
          && request.resource.data.sortOrder >= 0;

        allow delete: if isOwner();
      }

      match /migration_state/{migrationId} {
        allow read: if isOwner();

        allow create, update: if isOwner()
          && migrationId == 'favorite_products'
          && request.resource.data.keys().hasOnly(['completedAt'])
          && request.resource.data.completedAt == request.time;

        allow delete: if false;
      }
    }

    // Server-only machine ownership and audit metadata.
    // Admin SDK / Callable Functions bypass Rules; clients never access this.
    match /vending_machine_private/{document=**} {
      allow read, write: if false;
    }

    // photos, revisions and all other paths remain deny-by-default until
    // their own implementation phases.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

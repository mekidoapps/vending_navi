rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isUuidV4(value) {
      return value.matches(
        '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$'
      );
    }

    // Emulator-only mirror of the Phase 7 temporary path.
    // The current Storage emulator cannot reliably validate the production
    // resource == null immutability guard for upload requests, so overwrite
    // immutability is verified by production rule review + server photo hash
    // binding instead of weakening firebase/v2/storage.rules.
    match /machine_uploads/{uid}/{uploadId}/original.jpg {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
                    && isUuidV4(uploadId)
                    && request.resource.size > 0
                    && request.resource.size <= 5 * 1024 * 1024
                    && request.resource.contentType == 'image/jpeg';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

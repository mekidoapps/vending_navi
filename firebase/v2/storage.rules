rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isUuidV4(value) {
      return value.matches(
        '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$'
      );
    }

    // Temporary upload area shared by production and the Emulator Suite.
    // `create` permits the first upload only, so clients cannot overwrite or
    // delete existing objects. Cleanup remains server-side through Admin SDK.
    match /machine_uploads/{uid}/{uploadId}/original.jpg {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
                    && isUuidV4(uploadId)
                    && request.resource.size > 0
                    && request.resource.size <= 5 * 1024 * 1024
                    && request.resource.contentType == 'image/jpeg';
    }

    function isActiveMachine(machineId) {
      return firestore.exists(
        /databases/(default)/documents/vending_machines/$(machineId)
      )
      && firestore.get(
        /databases/(default)/documents/vending_machines/$(machineId)
      ).data.status == 'active';
    }

    function isActiveFormalPhoto(machineId, photoId) {
      return firestore.exists(
        /databases/(default)/documents/vending_machines/$(machineId)/photos/$(photoId)
      )
      && firestore.get(
        /databases/(default)/documents/vending_machines/$(machineId)/photos/$(photoId)
      ).data.status == 'active';
    }

    // Only server-side Functions create formal copies. A formal image becomes
    // readable when both its public metadata and parent machine are active.
    match /vending_machines/{machineId}/{photoId}/original.jpg {
      allow read: if isActiveMachine(machineId)
                  && isActiveFormalPhoto(machineId, photoId);
      allow write: if false;
    }

    // Every other path remains closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
